      "source": [
        "# キーボードから2つの整数を入力する\n",
        "# int()を使って、入力された文字を整数に変換しています\n",
        "num1 = int(input(\"1つ目の整数（割られる数）を入力してください: \"))\n",
        "num2 = int(input(\"2つ目の整数（割る数）を入力してください: \"))\n",
        "\n",
        "# 0で割るエラーを防ぐためのチェック（任意ですが入れておくと安心です）\n",
        "if num2 == 0:\n",
        "    print(\"エラー: 0で割ることはできません。\")\n",
        "else:\n",
        "    # 商を計算（// を使用）\n",
        "    quotient = num1 // num2\n",
        "\n",
        "    # 余りを計算（% を使用）\n",
        "    remainder = num1 % num2\n",
        "\n",
        "    # 結果を表示\n",
        "    print(\"--- 計算結果 ---\")\n",
        "    print(f\"{num1} を {num2} で割った場合:\")\n",
        "    print(f\"商: {quotient}\")\n",
        "    print(f\"余り: {remainder}\")"
      ]
    }
  ]
