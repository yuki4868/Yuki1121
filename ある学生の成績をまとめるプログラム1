      "source": [
        "print(\"学籍番号と名前を入力してください\")\n",
        "aoto1=input(\"学籍番号:\")\n",
        "aoto2=input(\"名前:\")\n",
        "# 3つの数値を受け取って合計と平均を計算するプログラム(前回の課題から引用)\n",
        "\n",
        "print(\"すべてのテストの結果を入力してください\")\n",
        "num1 = float(input(\"国語テストの点数を入力してください: \"))\n",
        "num2 = float(input(\"数学テストの点数を入力してください: \"))\n",
        "num3 = float(input(\"英語テストの点数を入力してください: \"))\n",
        "\n",
        "# 合計を計算\n",
        "total = num1 + num2 + num3\n",
        "\n",
        "# 平均を計算（3つの数のため、3で割る）\n",
        "average = total / 3\n",
        "\n",
        "# 結果を表示\n",
        "print(\"--- 計算結果 ---\")\n",
        "print(f\"学籍番号:{aoto1}\")\n",
        "print(f\"名前:{aoto2}\")\n",
        "print(f\"合計: {total}\")\n",
        "print(f\"平均: {average}\")"
      ]
    }
